{
  "name": "semvibe",
  "version": "0.1.0",
  "description": "Zero-telemetry CLI to catch architectural drift and convention inconsistencies in TypeScript/Next.js projects",
  "main": "dist/cli.js",
  "bin": {
    "semvibe": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "typescript",
    "cli",
    "ai-agents",
    "cursor",
    "claude-code",
    "code-quality",
    "architecture",
    "linter",
    "conventions",
    "ast",
    "drift"
  ],
  "author": "sidzuya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidzuya/semvibe.git"
  },
  "bugs": {
    "url": "https://github.com/sidzuya/semvibe/issues"
  },
  "homepage": "https://github.com/sidzuya/semvibe#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^11.0.0",
    "ignore": "^7.0.12",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
